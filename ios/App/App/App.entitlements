<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Notificaciones push. Al publicar, Xcode lo cambia solo a "production" -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Enlaces de app.kipu.ec que abren la app (Universal Links). iOS los verifica con
	     https://app.kipu.ec/.well-known/apple-app-site-association (qué rutas entran). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:app.kipu.ec</string>
	</array>
	<!-- App Attest: prueba ante Firebase App Check que es la app original en un iPhone
	     real (lo pide el backend en X-Firebase-AppCheck). "production" como pide Firebase;
	     con firma automática, Xcode activa la capacidad en el App ID al compilar. -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
</dict>
</plist>
