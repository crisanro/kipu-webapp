<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Notificaciones: ícono de una tinta (scripts/iconos-app.mjs) y el verde de Kipu -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_kipu" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/ic_launcher_background" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Enlaces de app.kipu.ec que abren la app (App Links, components/shell/PuenteNativo.tsx).
                 Android los verifica con https://app.kipu.ec/.well-known/assetlinks.json.
                 Solo las pantallas de la app: planes, renta, admin, equipo, api-keys, blog y
                 volver-a-la-app siguen en el navegador (las tiendas no permiten vender en la app). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.kipu.ec" />
                <data android:pathPrefix="/dashboard" />
                <data android:pathPrefix="/documentos" />
                <data android:pathPrefix="/personas" />
                <data android:pathPrefix="/productos" />
                <data android:pathPrefix="/cuentas" />
                <data android:pathPrefix="/proformas" />
                <data android:pathPrefix="/cobros" />
                <data android:pathPrefix="/reportes" />
                <data android:pathPrefix="/declarar-mes-anterior" />
                <data android:pathPrefix="/configuracion" />
                <data android:pathPrefix="/estructura" />
                <data android:pathPrefix="/usuarios" />
                <data android:pathPrefix="/auditoria" />
                <data android:pathPrefix="/al-dia" />
                <data android:pathPrefix="/uso-justo" />
                <data android:pathPrefix="/nueva-empresa" />
                <data android:pathPrefix="/mas" />
                <data android:pathPrefix="/login" />
                <data android:pathPrefix="/register" />
                <data android:pathPrefix="/reset" />
                <data android:pathPrefix="/bienvenida" />
                <data android:pathPrefix="/onboarding" />
                <data android:pathPrefix="/ayuda" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lector de códigos de barras (productos y emitir) y foto del comprobante físico -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
